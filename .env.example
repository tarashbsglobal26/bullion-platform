# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/bullion_platform"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-min-32-chars-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Twelve Data (https://twelvedata.com — free tier available)
# Used for live Gold spot price. Silver/Platinum/Palladium come from gold-api.com (no key needed).
# Without this key, the platform falls back to last stored spot prices.
TWELVE_DATA_API_KEY=""

# Cloudflare R2 (product image uploads)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
